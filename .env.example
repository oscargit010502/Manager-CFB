# Referencia: Django no carga este archivo automáticamente.
# Exporte las variables en su terminal o configúrelas en el gestor de servicios.
# Desarrollo local únicamente:
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# CFB_DATA_DIR=/ruta/absoluta/privada/cfb
# Producción: DJANGO_DEBUG=0 y DJANGO_SECRET_KEY desde un gestor de secretos.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://su-dominio
# CFB_TRUST_PROXY=1 solo si el proxy confiable reemplaza X-Forwarded-Proto.
# PostgreSQL opcional para desarrollo, recomendado para varios usuarios:
# POSTGRES_DB=cfb
# POSTGRES_USER=cfb
# POSTGRES_PASSWORD: configurar de forma segura; nunca guardar en Git.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=verify-full para PostgreSQL remoto con certificado confiable.
